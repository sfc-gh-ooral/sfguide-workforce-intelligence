# Snowflake connection for Live mode. Copy to .env.local (gitignored) and fill in.
# Without .env.local the app runs in Sample mode on bundled synthetic data.
# The app runs each persona's queries under its own role (WI_HRBP_ROLE, WI_COMP_ROLE,
# WI_CHRO_ROLE), which sql/setup.sql creates and grants to the user who runs it.
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USERNAME=<YOUR_USER>
SNOWFLAKE_DATABASE=WORKFORCE_INTEL_DB
SNOWFLAKE_SCHEMA=HR
SNOWFLAKE_WAREHOUSE=WORKFORCE_INTEL_WH
SNOWFLAKE_AGENT_NAME=WORKFORCE_INTEL_DB.HR.WORKFORCE_AGENT
# Model for the AI_COMPLETE panels. Use any model available in your region.
# SNOWFLAKE_COMPLETE_MODEL=claude-sonnet-4-5

# Authentication: key pair. Keep the key OUTSIDE this repository:
#   mkdir -p ~/.snowflake/keys
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/keys/workforce_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/keys/workforce_key.p8 -pubout
#   ALTER USER <YOUR_USER> SET RSA_PUBLIC_KEY_2 = '<public key body without header lines>';
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/.snowflake/keys/workforce_key.p8
